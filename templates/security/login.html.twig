{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <h1>Connexion</h1>

    {% if error %}
        <p class="form-error" role="alert">Identifiant ou mot de passe invalide.</p>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" class="login-form">
        <div>
            <label for="username">Identifiant</label>
            <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
        </div>

        <div>
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div>
            <button type="submit">Se connecter</button>
        </div>
    </form>
{% endblock %}
